# ==============================================================================
# COMPANY OS CORE — ENVIRONMENT CONFIGURATION
# Copy this file to .env (and apps/api/.env, apps/web/.env.local)
# ==============================================================================

# --- Database (PostgreSQL 16) ---
DATABASE_URL="postgresql://companyos:companyos_secret@localhost:5432/company_os?schema=public"

# --- Redis (BullMQ Sync Queue & Event Bus) ---
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# --- Backend Server ---
PORT="4000"
NODE_ENV="development"
API_BASE_URL="http://localhost:4000"
FRONTEND_URL="http://localhost:3000"

# --- Security & Encryption ---
# Generate strong random 32+ char strings for production!
JWT_ACCESS_SECRET="change-me-super-secret-access-key-min-32-chars"
JWT_REFRESH_SECRET="change-me-super-secret-refresh-key-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
# Must be exactly 64 hex characters (32 bytes) for AES-256-GCM OAuth token encryption:
# Run: openssl rand -hex 32
ENCRYPTION_KEY_HEX="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# --- Google OAuth 2.0 (Login + Auto Drive Folder + Two-Way Sheets Sync) ---
# Create in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:4000/api/v1/auth/google/callback"
GOOGLE_SHEETS_REDIRECT_URI="http://localhost:4000/api/v1/core/sheets/oauth/callback"
# Optional: Public HTTPS URL for Google Drive Push Webhook (required in production for instant Sheet->DB sync)
GOOGLE_WEBHOOK_PUBLIC_URL="https://api.yourdomain.com/api/v1/core/sheets/webhook"

# --- Frontend Public Env (apps/web/.env.local) ---
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_APP_NAME="Company OS"

# --- SaaS Platform Super-Admin Control Plane (Beta / Testing / Billing) ---
# Comma-separated emails of SaaS owners who can access /platform-admin
PLATFORM_ADMIN_EMAILS="founder@theprimeclasses.com,admin@companyos.com"
# Razorpay Webhook Secret (for automatic subscription activation)
RAZORPAY_WEBHOOK_SECRET="change-me-razorpay-webhook-secret"

# Default Free Trial Days for new Self-Serve SaaS Signups (e.g. 15 or 30)
DEFAULT_TRIAL_DAYS=15
